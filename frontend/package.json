{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint 'src/**/*.{ts,tsx,vue}'",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint 'src/**/*.{ts,tsx,vue}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,vue,css,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,vue,css,json}'",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.1",
    "@mdi/js": "^7.4.47",
    "axios": "^1.13.2",
    "codemirror": "^6.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "sass": "^1.97.2",
    "sass-embedded": "^1.97.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.24",
    "vue-codemirror": "^6.1.1",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.4",
    "vuetify": "^3.11.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.9",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.20.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.2.5",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.4"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,json}": [
      "prettier --write"
    ]
  }
}
